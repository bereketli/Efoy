# Copy to .env for local development. The Makefile loads and exports it.
# Nested config keys use a double underscore: EFOY_HTTP__ADDR -> http.addr.

EFOY_ENV=dev
EFOY_LOG__LEVEL=debug
EFOY_LOG__FORMAT=text

EFOY_DATABASE__URL=postgres://efoy:efoy@localhost:5432/efoy?sslmode=disable
EFOY_REDIS__ADDR=localhost:6379
EFOY_NATS__URL=nats://localhost:4222
EFOY_S3__ENDPOINT=localhost:9000
EFOY_S3__ACCESS_KEY=efoy
EFOY_S3__SECRET_KEY=efoy-dev-secret
EFOY_OSRM__URL=http://localhost:5000

# Auth. In dev these may stay empty: core-api then uses fixed, publicly known
# dev keys and logs a warning. Staging and prod refuse to start without them
# (make gen-keys prints a fresh pair).
# EFOY_AUTH__SIGNING_KEY=
# EFOY_AUTH__TOTP_KEY=

# OTP SMS: "console" writes codes to the core-api log instead of sending them.
EFOY_SMS__PROVIDER=console
